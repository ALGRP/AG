{
  "name": "ag-network",
  "private": true,
  "type": "module",
  "description": "Alanya Group uydu site a\u011f\u0131 + merkezi rezervasyon/havuz/komisyon sistemi (LOCAL_ONLY aday)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p qa-independent/tsconfig.json",
    "test": "node --test --test-concurrency=1 \"packages/*/src/**/*.test.ts\" \"apps/*/src/**/*.test.ts\" \"qa-independent/**/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "db:generate-id-format": "node packages/db/src/generate-id-format.ts",
    "build:sites": "node packages/ssg/src/cli.ts",
    "dev:api": "NODE_ENV=development node --watch apps/api/src/main.ts",
    "report:sample": "node apps/api/src/sample-week.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3"
  }
}
